<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_qr" name="Kamdoo: connect my phone">
        <t t-call="web.layout">
            <t t-set="title">Kamdoo</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #F5F6FA; color: #11131F; margin: 0; }
                    .kamdoo-page { max-width: 460px; margin: 48px auto; padding: 32px 24px; background: #fff; border-radius: 24px; text-align: center; box-shadow: 0 10px 40px rgba(20, 24, 61, .08); }
                    .kamdoo-page h1 { font-size: 22px; margin: 16px 0 4px; }
                    .kamdoo-page p { color: #5E6375; line-height: 1.5; margin: 6px 0; }
                    .kamdoo-page img.kamdoo-qr { width: 260px; height: 260px; margin: 20px auto; display: block; }
                    .kamdoo-page img.kamdoo-logo { max-height: 56px; max-width: 180px; }
                    .kamdoo-page ol { text-align: left; color: #11131F; line-height: 1.7; padding-left: 22px; margin: 16px 0 0; }
                    .kamdoo-page .kamdoo-note { font-size: 13px; margin-top: 16px; }
                </style>
            </t>
            <div class="kamdoo-page">
                <img class="kamdoo-logo" t-att-src="'/web/binary/company_logo?company=%s' % company.id" t-att-alt="company.name"/>
                <h1>Connect my phone</h1>
                <p><t t-esc="company.name"/> on your phone, with the Kamdoo app.</p>
                <img class="kamdoo-qr" t-att-src="qr_src" alt="QR code"/>
                <ol>
                    <li>Install <b>Kamdoo</b> from the App Store or Google Play.</li>
                    <li>Open it and tap <b>Scan my company's QR code</b>.</li>
                    <li>That's it: you are signed in on your phone.</li>
                </ol>
                <p class="kamdoo-note">This code works once and for five minutes; showing it again cancels the previous one.
                It holds no password. Your phone then appears in Preferences › Account Security › Devices, where you can sign it out.</p>
                <p><a href="/kamdoo/qr">Show a new code</a></p>
            </div>
        </t>
    </template>
</odoo>
