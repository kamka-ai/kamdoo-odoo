<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kamdoo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="after">
                <block title="Kamdoo mobile app" name="kamdoo_setting_container">
                    <setting id="kamdoo_setting" string="Kamdoo on your phone and tablet"
                             help="Each user opens their user menu › Connect my phone, and scans the QR code with the Kamdoo app. Notifications are encrypted for each phone and forwarded by the Kamdoo relay to Apple or Google; the relay cannot read them.">
                        <div class="mt8">
                            <a href="/kamdoo/qr" target="_blank" role="button" class="btn btn-link px-0">
                                <i class="oi oi-arrow-right me-1"/>Show my QR code
                            </a>
                        </div>
                    </setting>
                    <setting id="kamdoo_cle_setting" string="Phone keys"
                             help="Paired phones and their assistants (Siri, Gemini) use a key of their own with the JSON-2 API. Users revoke it in Preferences › Account Security.">
                        <div class="mt8">
                            <field name="kamdoo_duree_cle" class="oe_inline"/> days
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
